# ========================
# 🚀 TransBot AI - Production Environment Template
# ========================
# Domain: transbotai.com
# Server IP: 185.158.133.1
#
# COPY THIS FILE TO .env.production AND UPDATE WITH YOUR VALUES
# cp env.production.template .env.production

# ========================
# 🌐 GLOBAL APP SETTINGS
# ========================
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=TransBot AI
NEXT_PUBLIC_APP_URL=https://transbotai.com
PORT=3000

# ========================
# 🛡️ SUPABASE CONFIGURATION
# ========================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ========================
# 🤖 MCP + AUTONOMOUS AGENTS
# ========================
NEXT_PUBLIC_MCP_API_URL=https://transbotai.com/api
NEXT_PUBLIC_CURSOR_AI_URL=https://cursor.transbotai.com/api
MCP_SECRET_KEY=your-mcp-secret-key-here
CURSOR_API_KEY=your-cursor-api-key-here

# ========================
# 🔐 AUTHENTICATION
# ========================
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=https://transbotai.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========================
# 💳 STRIPE PAYMENTS
# ========================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ========================
# 📬 EMAIL DELIVERY (Resend / SMTP)
# ========================
EMAIL_FROM=no-reply@transbotai.com
RESEND_API_KEY=your-resend-api-key
SMTP_HOST=smtp.transbotai.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# ========================
# ⚙️ THIRD-PARTY INTEGRATIONS
# ========================
OPENAI_API_KEY=your-openai-api-key
N8N_WEBHOOK_URL=https://n8n.transbotai.com/webhook
GITHUB_TOKEN=your-github-token

# ========================
# 🚨 SECURITY & MONITORING
# ========================
SENTRY_DSN=your-sentry-dsn
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ========================
# ⚙️ FRONTEND CONTROLS
# ========================
DISABLE_ANIMATIONS=false
USE_REDUCED_MOTION=false
DEBUG_MODE=false

# ========================
# 🐳 DOCKER CONFIGURATION
# ========================
# CORS Settings for Production
CORS_ORIGIN=https://transbotai.com
BASE_URL=https://transbotai.com

# SSL Certificate Paths
SSL_CERT_PATH=/etc/letsencrypt/live/transbotai.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/transbotai.com/privkey.pem

# ========================
# 📊 MONITORING & LOGGING
# ========================
LOG_LEVEL=info
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# ========================
# 🔄 RATE LIMITING
# ========================
API_RATE_LIMIT=100
LOGIN_RATE_LIMIT=5
BURST_LIMIT=20

# ========================
# 🧪 QA INTELLIGENCE LAYER
# ========================
MCP_CONFIDENCE_LOGGING=true
MCP_ALERT_THRESHOLD=0.4
MCP_SUCCESS_THRESHOLD=0.8
MCP_RETRY_LIMIT=3
QA_DASHBOARD_ENABLED=true

# ========================
# 🔐 SECURITY KEYS (GENERATE THESE)
# ========================
# Generate with: openssl rand -base64 32
JWT_SECRET=generate_strong_jwt_secret_here
ENCRYPTION_KEY=generate_strong_encryption_key_here
SESSION_SECRET=generate_strong_session_secret_here

# ========================
# 📝 DEPLOYMENT NOTES
# ========================
# 1. Replace all 'your-*' values with actual credentials
# 2. Generate strong secrets using: openssl rand -base64 32
# 3. Ensure all API keys are production-ready (not test keys)
# 4. Test all integrations before going live
# 5. Keep this file secure and never commit to version control
